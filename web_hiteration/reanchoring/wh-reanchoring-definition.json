  "definition": {
    "term": "REANCHORING",
    "spanish_term": "REANCLAJE",
    "category": "CONTEXTUAL_AND_STRUCTURAL_CONTINUITY_OPERATION",
    "definition": "Proceso mediante el cual un sistema vuelve a vincular su estado operativo, interpretacion o produccion actual con un conjunto previamente establecido de referencias, restricciones, invariantes y relaciones relevantes, con el proposito de recuperar continuidad estructural sin asumir que el contexto anterior permanece integramente disponible.",
    "primary_function": "RESTORE_STRUCTURAL_CONTINUITY",
    "operational_purpose": "REDUCIR_CONTEXTUAL_DRIFT_AND_PRESERVE_RELEVANT_CONSTRAINTS"
  },

  "terminology_policy": {
    "rule": "TECHNICAL_TERMS_ARE_NOT_AUTO_TRANSLATED",
    "explanation": "Los terminos tecnicos del corpus se preservan en su forma canonica. La traduccion automatica por capas de presentacion no constituye equivalencia semantica.",
    "canonical_form": "REANCHORING",
    "rejected_variants": [
      "Reanclaje automatico",
      "Re-anclaje con guion",
      "Reanchorizacion",
      "Reanchor"
    ],
    "note": "El termino deriva de anchor (ancla) mas el prefijo re-. Su traduccion al espanol como 'reanclaje' es aceptable como glosa, pero el termino canonico en el corpus es REANCHORING."
  },

  "what_reanchoring_does": {
    "01": "IDENTIFICA_EL_PUNTO_DE_REFERENCIA",
    "02": "RECUPERA_LAS_REGLAS_O_INVARIANTES_RELEVANTES",
    "03": "REESTABLECE_LAS_RELACIONES_ENTRE_LOS_ELEMENTOS_RELEVANTES",
    "04": "COMPARA_EL_ESTADO_ACTUAL_CON_EL_ESTADO_DE_REFERENCIA",
    "05": "DETECTA_DESVIACIONES_RELEVANTES",
    "06": "REORIENTA_LA_CONTINUACION_DEL_PROCESO_HACIA_LAS_REFERENCIAS_VALIDAS",
    "07": "MANTIENE_EXPLICITA_LA_SEPARACION_ENTRE_CONTINUIDAD_RECONSTRUIDA_Y_CONTINUIDAD_HISTORICA_REAL"
  },

  "what_reanchoring_is_not": [
    "NO_ES_RECUPERACION_LITERAL_DE_UN_ESTADO_ANTERIOR",
    "NO_ES_MEMORIA_PERFECTA",
    "NO_ES_RECONSTRUCCION_COMPLETA_DEL_PROCESO_INTERNO",
