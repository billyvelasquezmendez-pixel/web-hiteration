  "progressive_reanchoring": {
    "definition": "Modalidad en la que el reanclaje se realiza gradualmente, comenzando por las referencias estructurales de mayor prioridad y reincorporando progresivamente contexto adicional segun su relevancia.",
    "sequence": [
      "CORE_ANCHORS",
      "PRIMARY_INVARIANTS",
      "SYSTEM_IDENTITY",
      "DEPENDENCIES",
      "CURRENT_STATE",
      "SECONDARY_CONTEXT",
      "OPEN_OR_UNRESOLVED_ELEMENTS"
    ],
    "purpose": "EVITAR_QUE_LA_REINCORPORACION_MASIVA_DE_CONTEXTO_PRODUZCA_DESVIACION_O_COMPRESION_ESTRUCTURAL"
  },

  "inverse_first": {
    "status": "METHOD_COMPONENT",
    "definition": "Antes de incorporar nuevo contexto, identificar que elementos del estado actual pueden contradecir, degradar o desplazar las referencias estructurales existentes.",
    "purpose": "DETECT_POTENTIAL_DRIFT_BEFORE_PROGRESSIVE_REANCHORING"
  },

  "web_hiteration_relation": {
