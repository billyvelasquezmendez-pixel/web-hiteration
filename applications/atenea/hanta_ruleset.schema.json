{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HANTA_RULESET_SCHEMA",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "reference_case": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "country": { "type": "string" },
        "period": { "type": "string" }
      },
      "required": ["project"]
    },
    "detected_biases": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  },
  "required": ["project", "reference_case"]
}
