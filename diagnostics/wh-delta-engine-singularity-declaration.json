    "secondary_rule": "SAME_PURPOSE_IS_NOT_SAME_PROCESS",
    "tertiary_rule": "NORMALIZATION_IS_NOT_SEMANTIC_EQUIVALENCE",
    "epistemic_boundary": "Este documento declara la singularidad. No la resuelve arquitectónicamente."
  },

  "singularity_thesis": {
    "statement": "Los dos motores DELTA no son variantes del mismo motor. Son dos motores singulares que comparten nombre, propósito aparente y símbolos parciales, pero operan sobre procesos distintos y miden cosas distintas con cada símbolo.",
    "consequence": "Los valores de δ, δ′ y score producidos por cada motor NO son comparables entre sí sin capa de normalización previa que no existe actualmente.",
    "classification": "DUAL_SINGULARITY_CONFIRMED"
  },

