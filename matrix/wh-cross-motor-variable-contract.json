  "meta": {
    "purpose": "Registrar variables transversales al corpus, sus definiciones, formulas, procedencia, consumidores y condiciones de transferencia entre motores.",
    "scope_isolation": "CROSS_MOTOR_VARIABLE_DECLARATION_ONLY",
    "note": "Este documento no asigna valores. Declara contratos de transferencia. Los valores concretos viven en los protocolos de cada motor."
  },

  "variables": [
    {
      "identifier": "SIGMA_DISPERSION",
      "legacy_symbol": "sigma",
      "definition": "Desviacion estandar de un conjunto de observaciones.",
      "origin": "GEMINI",
      "formula_required": true,
      "requirements": [
        "IDENTIFICAR_LAS_OBSERVACIONES",
        "DECLARAR_LA_ESCALA",
        "ESPECIFICAR_LA_FORMULA",
        "DOCUMENTAR_LA_NORMALIZACION_SI_EXISTE"
      ],
      "consumers": ["MOTOR_B", "CONI_CALCULATION"],
      "transfer_conditions_to_other_motors": [
        "SAME_SEMANTIC_DEFINITION",
        "COMPATIBLE_SCALE_AND_UNITS",
        "DECLARED_NORMALIZATION",
        "EXPLICIT_INPUT_OUTPUT_MAPPING",
        "REPRODUCIBLE_CALCULATION"
      ],
      "notes": "Es la variable que aparece en el manifiesto WH-CEB-2026-003 con valor 0.142."
    },
    {
      "identifier": "VARIANCE",
      "legacy_symbol": null,
      "definition": "Medida cuadratica de dispersion respecto de una media.",
      "origin": "GEMINI",
      "formula_required": true,
      "relationship_to_sigma_dispersion": "VARIANCE = SIGMA_DISPERSION^2 bajo la misma convencion de calculo.",
      "constraint": "NO_INTERCAMBIAR_VARIANCE_AND_STANDARD_DEVIATION_WITHOUT_TRANSFORMATION",
      "consumers": ["UNASSIGNED"],
      "notes": "Registrada como variable distinta a SIGMA_DISPERSION para evitar uso cruzado sin transformacion."
    },
    {
      "identifier": "SIGMA_COHERENCE",
      "legacy_symbol": null,
      "definition": "Variable de coherencia sistemica. Requiere definicion explicita en el protocolo que la use.",
      "origin": "UNASSIGNED",
      "formula_required": true,
      "operational_status": "REQUIRES_FORMULA_AND_MEASUREMENT_CONTRACT",
      "consumers": ["UNASSIGNED"],
      "notes": "Si en algun momento se decide que 'sigma' en Motor A es coherencia sistemica y no dispersion estadistica, ese uso debe migrar a este identificador."
    },
    {
      "identifier": "DELTA_PRIME",
      "legacy_symbol": "delta_prime",
      "definition": "Factor de desviacion/atenuacion ajustado por precision primaria.",
      "origin": "CHATGPT",
      "declared_formula": "delta_prime = SIGMA_DISPERSION * (1 - P1)",
      "formula_status": "PROVISIONAL",
      "declared_value_in_manifest": 0.228,
      "calculated_from_formula": 0.025134,
      "discrepancy": "UNRESOLVED",
      "notes": "Ver wh-delta-prime-motor-sigma-diagnostic.json para el diagnostico completo.",
      "consumers": ["SCORE_CALCULATION"],
      "provenance_status": "PENDING_P0_RECOVERY"
    }
  ],

  "transfer_matrix": {
    "MOTOR_A_TO_MOTOR_B": {
      "allowed_variables": ["SCORE"],
      "conditions": ["SAME_SEMANTIC_DEFINITION", "COMPATIBLE_SCALE_AND_UNITS"],
      "excluded_variables": ["P1", "P3", "P5", "E8", "HR", "Tc"]
    },
    "MOTOR_B_TO_MOTOR_A": {
      "allowed_variables": ["SIGMA_DISPERSION_WITH_CONTRACT"],
      "conditions": ["EXPLICIT_SEMANTIC_QUALIFICATION"],
      "excluded_variables": ["CONI", "ContextDecay", "FalsificationBias"]
    }
  },

  "cross_motor_terminology": {
    "shared_symbols_declared": ["sigma", "score", "RiskLevel"],
    "disambiguation_rule": "TODO_SIMBOLO_COMPARTIDO_REQUIERE_IDENTIFICADOR_EXPLICITO_CON_SUFIJO_DE_CONTEXTO"
  },

  "final_classification": {
    "type": "CROSS_MOTOR_VARIABLE_CONTRACT",
    "canonicalization": "PENDING_REVIEW",
    "note": "Este contrato declara variables transversales y sus condiciones de transferencia. No asigna valores. No valida formulas. Registra las reglas para que los motores puedan intercambiar variables sin colision semantica."
  }
